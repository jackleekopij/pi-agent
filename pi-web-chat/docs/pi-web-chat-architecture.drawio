        <mxCell id="n1" value="1. User sends prompt / files" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D71638;endArrow=block;" edge="1" parent="1" source="u" target="b"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="200" as="sourcePoint" /><mxPoint x="385" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n2" value="2. WebSocket {type: prompt, attachments}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D71638;endArrow=block;" edge="1" parent="1" source="b" target="s"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="250" as="sourcePoint" /><mxPoint x="665" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n3" value="3. session.prompt(composed text + images)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0071BC;endArrow=block;" edge="1" parent="1" source="s" target="a"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="300" as="sourcePoint" /><mxPoint x="945" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n4" value="4. Model stream / tool-use decisions" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D71638;endArrow=block;" edge="1" parent="1" source="a" target="m"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="350" as="sourcePoint" /><mxPoint x="1215" y="350" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n5" value="5. Tool call: visualize / ask_question" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4D4D4F;endArrow=block;" edge="1" parent="1" source="a" target="t"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="420" as="sourcePoint" /><mxPoint x="1485" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n6" value="6. Tool result: text content + details.viz/details.question" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#4D4D4F;endArrow=block;dashed=1;" edge="1" parent="1" source="t" target="a"><mxGeometry relative="1" as="geometry"><mxPoint x="1485" y="470" as="sourcePoint" /><mxPoint x="945" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n7" value="7. Server receives tool_execution_end" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0071BC;endArrow=block;dashed=1;" edge="1" parent="1" source="a" target="s"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="530" as="sourcePoint" /><mxPoint x="665" y="530" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n8" value="8a. If details.viz: WS {type: viz, html}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#75287B;endArrow=block;" edge="1" parent="1" source="s" target="b"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="590" as="sourcePoint" /><mxPoint x="385" y="590" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n9" value="8b. Browser renders iframe HTML / draggable SVG network" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#75287B;endArrow=block;" edge="1" parent="1" source="b" target="u"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="640" as="sourcePoint" /><mxPoint x="135" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n10" value="9a. If details.question: WS {type: question}" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D71638;endArrow=block;" edge="1" parent="1" source="s" target="b"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="710" as="sourcePoint" /><mxPoint x="385" y="710" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n11" value="9b. Modal above composer; multiple questions are tabs" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D71638;endArrow=block;" edge="1" parent="1" source="b" target="u"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="760" as="sourcePoint" /><mxPoint x="135" y="760" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n12" value="10. User answers all tabs; browser sends answer_batch" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D71638;endArrow=block;" edge="1" parent="1" source="u" target="b"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="830" as="sourcePoint" /><mxPoint x="385" y="830" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n13" value="11. Server saves answers, then prompts model to mark all" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#003369;endArrow=block;" edge="1" parent="1" source="s" target="a"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="890" as="sourcePoint" /><mxPoint x="945" y="890" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="n14" value="12. Model calls mark_answer for each, then combined feedback" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D71638;endArrow=block;" edge="1" parent="1" source="m" target="a"><mxGeometry relative="1" as="geometry"><mxPoint x="1215" y="950" as="sourcePoint" /><mxPoint x="945" y="950" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="note2" value="Key design: visual UI payloads are not injected into model context. The LLM sees compact tool summaries; the browser receives rich HTML/details over WebSocket and renders them locally." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F6;strokeColor=#D71638;fontColor=#4D4D4F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1080" width="950" height="70" as="geometry" /></mxCell>
