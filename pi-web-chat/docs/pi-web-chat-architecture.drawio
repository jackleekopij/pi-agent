        <mxCell id="title" value="Pi Web Chat — Architecture and UI Component Generation" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#4D4D4F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="browser" value="Browser UI&#xa;public/index.html + app.js + CSS&#xa;• Chat transcript&#xa;• Sidebar conversations/activity&#xa;• Composer + file attach&#xa;• Input-required modal&#xa;• MCP/viz iframe host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D71638;strokeWidth=3;fontColor=#4D4D4F;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="310" height="190" as="geometry" /></mxCell>
        <mxCell id="local" value="Browser Local State&#xa;localStorage/sessionStorage&#xa;• conversations&#xa;• current conversation&#xa;• restored transcript HTML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#4D4D4F;fontColor=#4D4D4F;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="310" height="110" as="geometry" /></mxCell>
        <mxCell id="server" value="Node/Express + WebSocket Server&#xa;src/server.ts&#xa;• Serves static UI&#xa;• Maintains Pi AgentSession&#xa;• Bridges browser events ⇄ Pi events&#xa;• Saves uploads&#xa;• Forwards tool details to UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#003369;strokeWidth=3;fontColor=#4D4D4F;shadow=1;" vertex="1" parent="1"><mxGeometry x="520" y="130" width="330" height="190" as="geometry" /></mxCell>
        <mxCell id="sdk" value="Pi SDK AgentSession&#xa;@earendil-works/pi-coding-agent&#xa;• prompt()&#xa;• event stream&#xa;• custom tools&#xa;• model + thinking level&#xa;• session messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0071BC;strokeWidth=2;fontColor=#4D4D4F;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="300" height="170" as="geometry" /></mxCell>
        <mxCell id="model" value="ChatGPT / Codex OAuth Provider&#xa;openai-codex / gpt-5.5&#xa;• Text deltas&#xa;• Thinking deltas&#xa;• Tool calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F6;strokeColor=#D71638;strokeWidth=2;fontColor=#4D4D4F;" vertex="1" parent="1"><mxGeometry x="1310" y="130" width="240" height="170" as="geometry" /></mxCell>
        <mxCell id="tools" value="Custom Tools" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#4D4D4F;fontColor=#4D4D4F;startSize=30;" vertex="1" parent="1"><mxGeometry x="520" y="400" width="760" height="280" as="geometry" /></mxCell>
        <mxCell id="viz" value="Visualization Tools&#xa;src/viz-tools.ts&#xa;visualize, render_bar, render_network, render_sequence...&#xa;Returns: content summary + details.viz[{spec, html}]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#003369;fontColor=#4D4D4F;" vertex="1" parent="tools"><mxGeometry x="30" y="50" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="qtools" value="Question/Input Tools&#xa;src/question-tools.ts&#xa;ask_question, mark_answer, list_answers&#xa;Returns: details.question for browser modal&#xa;Answers saved in .pi-web-chat-assessment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D71638;fontColor=#4D4D4F;" vertex="1" parent="tools"><mxGeometry x="390" y="50" width="330" height="120" as="geometry" /></mxCell>
        <mxCell id="uploads" value="Uploads + Workspace Files&#xa;.pi-web-chat-uploads/&#xa;read_file, drag/drop, paperclip&#xa;Text included in prompt; binary saved as path; images sent as image inputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#50B848;fontColor=#4D4D4F;" vertex="1" parent="tools"><mxGeometry x="210" y="190" width="340" height="70" as="geometry" /></mxCell>
        <mxCell id="vizpkg" value="@pi-harness/viz package&#xa;packages/viz&#xa;Data → VizSpec → self-contained HTML&#xa;Network nodes draggable in iframe/SVG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#75287B;fontColor=#4D4D4F;" vertex="1" parent="1"><mxGeometry x="980" y="740" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="ws" value="WebSocket JSON Events&#xa;prompt, assistant_delta, thinking_delta, tool_start/update/end, viz, question, answer_batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E7E8;strokeColor=#4D4D4F;fontColor=#4D4D4F;" vertex="1" parent="1"><mxGeometry x="430" y="40" width="470" height="60" as="geometry" /></mxCell>
        <mxCell id="e1" value="static HTML/CSS/JS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4D4D4F;endArrow=block;" edge="1" parent="1" source="server" target="browser"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="/ws JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D71638;endArrow=block;startArrow=block;" edge="1" parent="1" source="browser" target="server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="createAgentSession / prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0071BC;endArrow=block;startArrow=block;" edge="1" parent="1" source="server" target="sdk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="model calls + tool calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D71638;endArrow=block;startArrow=block;" edge="1" parent="1" source="sdk" target="model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="register customTools" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4D4D4F;endArrow=block;" edge="1" parent="1" source="server" target="tools"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="details.viz html" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#75287B;endArrow=block;" edge="1" parent="1" source="viz" target="vizpkg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="persist UI history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4D4D4F;endArrow=block;startArrow=block;" edge="1" parent="1" source="browser" target="local"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note" value="UI component generation pattern: tools return lean text to the LLM, plus renderable details for the host. The server forwards details to the browser without spending model context. Browser renders visuals/MCP HTML in sandboxed iframes or input modals." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F6;strokeColor=#D71638;fontColor=#4D4D4F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="760" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
