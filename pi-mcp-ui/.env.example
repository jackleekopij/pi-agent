# --- pi agent configuration ---------------------------------------------------
# Provider + model passed to the pi RpcClient. If unset, pi uses its own
# configured defaults (~/.pi/agent settings; default provider is "google").
PI_PROVIDER=anthropic
PI_MODEL=claude-opus-4-5

# Working directory the pi coding agent operates in. The wrapped agent has FULL
# tools (read/bash/edit/write) on this directory, so set it deliberately.
# Defaults to the directory the server was launched from if unset.
PI_CWD=/Users/me/Projects/some-project

# Which UI track pi_open returns:
#   mcpui = @mcp-ui/server inline UIResource (default, broadest host support)
#   apps  = official MCP Apps / SEP-1865 (predeclared ui:// resource + _meta)
PI_MCP_UI_TRACK=mcpui

# Port for the standalone browser dev page (npm run dev).
PI_DEV_PORT=5174

# --- provider API keys (only what your PI_PROVIDER needs) ----------------------
# pi reads these from the environment it is spawned in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
